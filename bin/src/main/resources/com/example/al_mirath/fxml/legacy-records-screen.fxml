<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.al_mirath.controller.LegacyRecordsController"
            prefWidth="1280"
            prefHeight="720"
            styleClass="welcome-root">

    <top>
        <HBox alignment="CENTER_RIGHT"
              spacing="12"
              styleClass="records-top-bar">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>

            <Label text="Legacy Records"
                   HBox.hgrow="ALWAYS"
                   styleClass="records-title"/>

            <Button text="Clear Records"
                    onAction="#clearRecords"
                    styleClass="small-menu-button"/>

            <Button text="Main Menu"
                    onAction="#returnToMainMenu"
                    styleClass="small-menu-button"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="18"
              styleClass="records-panel">
            <padding>
                <Insets top="30" right="80" bottom="40" left="80"/>
            </padding>

            <Label fx:id="emptyLabel"
                   text="No lives have been completed yet."
                   styleClass="welcome-description"/>

            <ScrollPane fitToWidth="true"
                        prefHeight="560"
                        styleClass="records-scroll">
                <content>
                    <VBox fx:id="recordsBox"
                          spacing="14"/>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>