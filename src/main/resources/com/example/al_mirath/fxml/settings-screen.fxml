<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.al_mirath.controller.SettingsController"
            prefWidth="1280"
            prefHeight="720"
            stylesheets="@../css/almirath-theme.css">

    <styleClass>
        <String fx:value="welcome-root"/>
    </styleClass>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16">
            <padding>
                <Insets top="24" right="36" bottom="12" left="36"/>
            </padding>

            <Label text="Settings">
                <styleClass>
                    <String fx:value="records-title"/>
                </styleClass>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Main Menu" onAction="#returnToMainMenu">
                <styleClass>
                    <String fx:value="menu-button"/>
                </styleClass>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="18">
            <padding>
                <Insets top="10" right="36" bottom="30" left="36"/>
            </padding>

            <!-- PRESENTATION -->
            <VBox spacing="16" maxWidth="720">
                <styleClass>
                    <String fx:value="parchment-panel"/>
                </styleClass>

                <Label text="Presentation">
                    <styleClass>
                        <String fx:value="section-title"/>
                    </styleClass>
                </Label>

                <CheckBox fx:id="typewriterCheck"
                          text="Reveal event text one character at a time">
                    <styleClass>
                        <String fx:value="settings-check"/>
                    </styleClass>
                </CheckBox>

                <CheckBox fx:id="trialsCheck"
                          text="Offer a playable Trial of Skill on stat checks">
                    <styleClass>
                        <String fx:value="settings-check"/>
                    </styleClass>
                </CheckBox>
            </VBox>

            <!-- AUDIO -->
            <VBox spacing="12" maxWidth="720">
                <styleClass>
                    <String fx:value="parchment-panel"/>
                </styleClass>

                <Label text="Audio">
                    <styleClass>
                        <String fx:value="section-title"/>
                    </styleClass>
                </Label>

                <Label fx:id="musicValueLabel" text="Music: 45%">
                    <styleClass>
                        <String fx:value="info-label"/>
                    </styleClass>
                </Label>

                <Slider fx:id="musicSlider"
                        min="0" max="100" value="45"
                        maxWidth="Infinity"/>

                <Label fx:id="effectsValueLabel" text="Sound effects: 70%">
                    <styleClass>
                        <String fx:value="info-label"/>
                    </styleClass>
                </Label>

                <Slider fx:id="effectsSlider"
                        min="0" max="100" value="70"
                        maxWidth="Infinity"/>
            </VBox>

            <!-- DANGER ZONE -->
            <VBox spacing="12" maxWidth="720">
                <styleClass>
                    <String fx:value="parchment-panel"/>
                </styleClass>

                <Label text="Progress">
                    <styleClass>
                        <String fx:value="section-title"/>
                    </styleClass>
                </Label>

                <Label fx:id="resetStatusLabel"
                       text="Erasing progress clears every achievement and statistic. This cannot be undone."
                       wrapText="true">
                    <styleClass>
                        <String fx:value="achievement-hint"/>
                    </styleClass>
                </Label>

                <HBox spacing="12">
                    <Button fx:id="resetButton"
                            text="Erase All Progress"
                            onAction="#requestReset">
                        <styleClass>
                            <String fx:value="menu-button"/>
                            <String fx:value="danger-button"/>
                        </styleClass>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>
